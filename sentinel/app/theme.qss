/* Sentinel — dark trading-terminal stylesheet.
 *
 * Tokens (`@TOKEN@`) are substituted at load time from `theme.py::Colors`.
 * Add new colors there, not inline here. Class hooks used from Python:
 *
 *   QLabel#brand               — top-bar wordmark
 *   QLabel#brand-version       — top-bar version pill
 *   QLabel#section-header      — small uppercase divider label
 *   QLabel#status-dot          — connection indicator (with [state="…"])
 *   QLabel#status-meta         — status-bar permanent labels (exchanges, etc.)
 *   QWidget#chart-toolbar      — chart dock toolbar strip
 *   QFrame#group-separator     — vertical separator inside toolbars
 *   QPushButton[role="step"]   — compact +/- step buttons
 *   QPushButton[role="mode"]   — auto/manual segmented toggle
 *   QLabel#loading-overlay     — centered "Loading…" overlay
 *   QLabel#error-overlay       — inline error pill
 *   QWidget#delta-stats-panel  — chart+orderflow CVD stats strip
 */

/* ── Base ──────────────────────────────────────────────────────── */
QMainWindow { background: @BG_APP@; color: @TEXT_PRIMARY@; }
QMainWindow::separator { background: @BG_PANEL@; width: 2px; height: 2px; }
QMainWindow::separator:hover { background: @BORDER_HOVER@; }

/* pyqtgraph PlotWidget lives in a QGraphicsView — strip its frame */
QGraphicsView { border: none; background: @BG_CANVAS@; }

QWidget { color: @TEXT_PRIMARY@; }
QWidget:disabled { color: @TEXT_GHOST@; }

/* ── Menu bar ──────────────────────────────────────────────────── */
QMenuBar {
    background: @BG_PANEL@;
    color: @TEXT_SECONDARY@;
    border-bottom: 1px solid @BORDER_SUB@;
    font-size: 12px;
    padding: 1px 2px;
}
QMenuBar::item { padding: 5px 9px; background: transparent; }
QMenuBar::item:selected { background: @BG_HOVER@; }
QMenuBar::item:pressed { background: @BG_ACTIVE@; color: @ACCENT@; }

QMenu {
    background: @BG_PANEL_2@;
    color: @TEXT_PRIMARY@;
    border: 1px solid @BORDER@;
    padding: 4px;
}
QMenu::item { padding: 5px 22px 5px 14px; border: 1px solid transparent; }
QMenu::item:selected { background: @BG_SELECT@; border: 1px solid @BORDER@; color: @TEXT_PRIMARY@; }
QMenu::item:disabled { color: @TEXT_GHOST@; }
QMenu::separator { height: 1px; background: @BORDER_SUB@; margin: 4px 6px; }
QMenu::icon { padding-left: 6px; }

/* ── Toolbars ──────────────────────────────────────────────────── */
QToolBar {
    background: @BG_PANEL@;
    border: none;
    border-bottom: 1px solid @BORDER_SUB@;
    spacing: 2px;
    padding: 3px 6px;
}
QToolBar#toolbar\:drawing {
    border-bottom: none;
    border-right: 1px solid @BORDER_SUB@;
    padding: 5px 3px;
    spacing: 1px;
}
QToolBar::separator {
    background: @BORDER_SUB@;
    width: 1px;
    margin: 4px 4px;
}
QToolBar#toolbar\:drawing::separator {
    height: 1px;
    width: 18px;
    margin: 4px 4px;
}

/* ── Tool buttons (toolbar actions render as these) ─────────────── */
QToolButton {
    background: transparent;
    color: @TEXT_MUTED@;
    border: 1px solid transparent;
    border-radius: 2px;
    padding: 4px 8px;
    font-size: 12px;
}
QToolButton:hover {
    background: @BG_HOVER@;
    border: 1px solid @BORDER@;
    color: @TEXT_PRIMARY@;
}
QToolButton:checked, QToolButton:pressed {
    background: @BG_ACTIVE@;
    border: 1px solid @BORDER_FOCUS@;
    color: @ACCENT@;
}
QToolButton:disabled {
    color: @TEXT_GHOST@;
}

/* ── Splitter handles ──────────────────────────────────────────── */
QSplitter::handle { background: @BG_PANEL@; }
QSplitter::handle:vertical { height: 2px; }
QSplitter::handle:horizontal { width: 2px; }
QSplitter::handle:hover { background: @BORDER_HOVER@; }

/* ── Dock widgets ──────────────────────────────────────────────── */
QDockWidget {
    color: @TEXT_DIM@;
    font-size: 11px;
}
QDockWidget::title {
    background: @BG_PANEL@;
    color: @TEXT_DIM@;
    padding: 4px 10px 4px 12px;
    min-height: 22px;
    border-bottom: 1px solid @BORDER_SUB@;
    border-left: 2px solid @BORDER_SUB@;
    text-align: left;
    font-weight: 600;
}
QDockWidget::close-button, QDockWidget::float-button {
    background: transparent;
    border: 1px solid transparent;
    padding: 2px;
    icon-size: 12px;
    subcontrol-position: top right;
    subcontrol-origin: margin;
}
QDockWidget::close-button:hover {
    background: #3a1a1a;
    border: 1px solid #5a2a2a;
}
QDockWidget::float-button:hover {
    background: @BG_HOVER@;
    border: 1px solid @BORDER@;
}

/* ── Status bar ────────────────────────────────────────────────── */
QStatusBar {
    background: @BG_PANEL@;
    color: @TEXT_FAINT@;
    border-top: 1px solid @BORDER_SUB@;
    font-size: 11px;
    min-height: 22px;
}
QStatusBar::item { border: none; }
QStatusBar QLabel { color: @TEXT_FAINT@; }
QLabel#status-meta {
    color: @TEXT_FAINT@;
    padding: 0 10px;
    font-size: 11px;
    border-left: 1px solid @BORDER_SUB@;
}

/* Connection / health dot — set via property: state = "ok"|"warn"|"err"|"idle" */
QLabel#status-dot {
    padding: 0 10px 0 10px;
    font-size: 11px;
    border-left: 1px solid @BORDER_SUB@;
}
QLabel#status-dot[state="ok"]   { color: @UP@;   }
QLabel#status-dot[state="warn"] { color: @WARN@; }
QLabel#status-dot[state="err"]  { color: @DOWN@; }
QLabel#status-dot[state="idle"] { color: @TEXT_FAINT@; }

/* Brand wordmark in the global top toolbar */
QLabel#brand {
    color: @ACCENT@;
    font-weight: 700;
    font-size: 12px;
    padding: 0 8px 0 6px;
}
QLabel#brand-version {
    color: @TEXT_GHOST@;
    font-size: 10px;
    padding: 0 10px 0 0;
}

/* Section header — small uppercase divider used inside panels */
QLabel#section-header {
    color: @TEXT_GHOST@;
    font-size: 10px;
    font-weight: 600;
    padding: 4px 6px 2px 6px;
}

/* Group separator (vertical line) for toolbar/control rows */
QFrame#group-separator {
    background: @BORDER_SUB@;
    max-width: 1px;
    min-width: 1px;
    margin: 4px 4px;
}

/* ── Push buttons ──────────────────────────────────────────────── */
QPushButton {
    background: @BG_ELEV@;
    color: @TEXT_SECONDARY@;
    border: 1px solid @BORDER@;
    border-radius: 2px;
    padding: 3px 10px;
    min-width: 20px;
    font-size: 12px;
}
QPushButton:hover {
    background: @BG_HOVER@;
    border: 1px solid @BORDER_HOVER@;
    color: @TEXT_PRIMARY@;
}
QPushButton:pressed {
    background: @BG_PRESSED@;
    border: 1px solid @BORDER_FOCUS@;
}
QPushButton:checked {
    background: @BG_ACTIVE@;
    border: 1px solid @BORDER_FOCUS@;
    color: @ACCENT@;
}
QPushButton:disabled {
    background: @BG_APP@;
    color: @TEXT_GHOST@;
    border: 1px solid @BG_PANEL@;
}
QPushButton:flat { border: none; background: transparent; }

/* Compact +/- step buttons used by ladder / DOM controls */
QPushButton[role="step"] {
    min-width: 22px;
    max-width: 26px;
    padding: 2px 0;
    font-weight: 700;
    color: @TEXT_DIM@;
}
QPushButton[role="step"]:hover { color: @ACCENT@; }

/* Mode toggle (Auto / Manual) */
QPushButton[role="mode"] {
    min-width: 56px;
    padding: 2px 8px;
    font-size: 11px;
}

/* ── Combo boxes ───────────────────────────────────────────────── */
QComboBox {
    background: @BG_ELEV@;
    color: @TEXT_PRIMARY@;
    border: 1px solid @BORDER@;
    border-radius: 2px;
    padding: 3px 8px;
    min-width: 80px;
    font-size: 12px;
}
QComboBox:hover { border: 1px solid @BORDER_HOVER@; }
QComboBox:focus { border: 1px solid @BORDER_FOCUS@; }
QComboBox:disabled { color: @TEXT_GHOST@; }
QComboBox::drop-down { border: none; width: 14px; }
QComboBox QAbstractItemView {
    background: @BG_PANEL_2@;
    color: @TEXT_PRIMARY@;
    border: 1px solid @BORDER@;
    selection-background-color: @BG_SELECT@;
    selection-color: @TEXT_PRIMARY@;
    outline: none;
    padding: 2px;
}

/* ── Labels ────────────────────────────────────────────────────── */
QLabel { color: @TEXT_SECONDARY@; font-size: 12px; }
QLabel[role="caption"]    { color: @TEXT_FAINT@; font-size: 11px; }
QLabel[role="value"]      { color: @TEXT_PRIMARY@; font-size: 12px; }
QLabel[role="up"]         { color: @UP@; font-weight: 600; }
QLabel[role="down"]       { color: @DOWN@; font-weight: 600; }

/* Loading / error overlays used by the equity chart and similar surfaces.
 * `loading-overlay` covers its host widget so the chart underneath is dimmed
 * and the centered label is the focal point. */
QLabel#loading-overlay {
    color: @ACCENT@;
    background: rgba(6, 10, 17, 200);
    font-size: 12px;
    font-weight: 600;
    padding: 6px 14px;
}
QLabel#error-overlay {
    color: @DOWN@;
    background: rgba(64, 12, 18, 100);
    border: 1px solid @DOWN@;
    border-radius: 2px;
    padding: 2px 8px;
    font-size: 11px;
}

/* ── Check boxes ───────────────────────────────────────────────── */
QCheckBox { color: @TEXT_SECONDARY@; spacing: 6px; font-size: 12px; }
QCheckBox::indicator {
    width: 12px;
    height: 12px;
    background: @BG_ELEV@;
    border: 1px solid @BORDER@;
    border-radius: 2px;
}
QCheckBox::indicator:hover { border: 1px solid @BORDER_HOVER@; }
QCheckBox::indicator:checked {
    background: @ACCENT_DEEP@;
    border: 1px solid @ACCENT_LINE@;
}

/* ── Sliders ───────────────────────────────────────────────────── */
QSlider::groove:horizontal {
    height: 3px;
    background: @BORDER_SUB@;
    border-radius: 1px;
}
QSlider::handle:horizontal {
    background: @BORDER_FOCUS@;
    border: 1px solid @ACCENT_LINE@;
    width: 10px;
    height: 10px;
    border-radius: 5px;
    margin: -4px 0;
}
QSlider::handle:horizontal:hover { background: @ACCENT@; }
QSlider::sub-page:horizontal { background: @ACCENT_DEEP@; border-radius: 1px; }

/* ── Tables ────────────────────────────────────────────────────── */
QTableWidget {
    background: @BG_APP@;
    alternate-background-color: @BG_PANEL@;
    gridline-color: @BORDER_GRID@;
    border: none;
    outline: none;
    selection-background-color: @BG_SELECT@;
    font-size: 12px;
}
QTableWidget::item { padding: 1px 4px; border: none; }
QTableWidget::item:selected { background: @BG_SELECT@; }

QHeaderView { background: @BG_PANEL@; border: none; }
QHeaderView::section {
    background: @BG_PANEL@;
    color: @TEXT_FAINT@;
    border: none;
    border-right: 1px solid @BORDER_SUB@;
    border-bottom: 1px solid @BORDER_SUB@;
    padding: 4px 6px;
    font-size: 10px;
    font-weight: 700;
}
QHeaderView::section:last { border-right: none; }

/* ── Scrollbars ────────────────────────────────────────────────── */
QScrollBar:vertical {
    background: @BG_APP@;
    width: 6px;
    margin: 0;
    border: none;
}
QScrollBar::handle:vertical {
    background: @BORDER@;
    min-height: 24px;
    border-radius: 2px;
}
QScrollBar::handle:vertical:hover { background: @BORDER_HOVER@; }
QScrollBar::add-line:vertical, QScrollBar::sub-line:vertical { height: 0; }
QScrollBar::add-page:vertical, QScrollBar::sub-page:vertical { background: none; }

QScrollBar:horizontal {
    background: @BG_APP@;
    height: 6px;
    margin: 0;
    border: none;
}
QScrollBar::handle:horizontal {
    background: @BORDER@;
    min-width: 24px;
    border-radius: 2px;
}
QScrollBar::handle:horizontal:hover { background: @BORDER_HOVER@; }
QScrollBar::add-line:horizontal, QScrollBar::sub-line:horizontal { width: 0; }
QScrollBar::add-page:horizontal, QScrollBar::sub-page:horizontal { background: none; }

/* ── Chart inline toolbar ──────────────────────────────────────── */
QWidget#chart-toolbar {
    background: @BG_PANEL@;
    border-bottom: 1px solid @BORDER_STRIP@;
    min-height: 34px;
    max-height: 38px;
}

QWidget#chart-toolbar QComboBox {
    min-width: 64px;
    padding: 2px 6px;
    font-size: 11px;
}

QWidget#chart-toolbar QCheckBox {
    color: @TEXT_FAINT@;
    spacing: 4px;
    font-size: 11px;
    padding: 1px 6px;
    border: 1px solid transparent;
    border-radius: 2px;
}
QWidget#chart-toolbar QCheckBox:hover {
    color: @TEXT_MUTED@;
    border: 1px solid @BORDER@;
    background: @BG_ELEV@;
}
QWidget#chart-toolbar QCheckBox:checked {
    color: @ACCENT@;
    background: @BG_ACTIVE@;
    border: 1px solid @ACCENT_LINE@;
}
QWidget#chart-toolbar QCheckBox::indicator {
    width: 0px;
    height: 0px;
}

QWidget#chart-toolbar QLabel {
    color: @TEXT_GHOST@;
    font-size: 11px;
}
QWidget#chart-toolbar QLabel[role="context"] {
    color: @TEXT_DIM@;
    font-size: 11px;
    padding: 0 4px;
}

/* ── Input fields ──────────────────────────────────────────────── */
QLineEdit {
    background: @BG_ELEV@;
    color: @TEXT_PRIMARY@;
    border: 1px solid @BORDER@;
    border-radius: 2px;
    padding: 3px 6px;
    font-size: 12px;
    selection-background-color: @BG_SELECT@;
}
QLineEdit:focus { border: 1px solid @BORDER_FOCUS@; }
QLineEdit:hover { border: 1px solid @BORDER_HOVER@; }
QLineEdit:disabled { color: @TEXT_GHOST@; }

/* ── Spin / numeric inputs ─────────────────────────────────────── */
QSpinBox, QDoubleSpinBox {
    background: @BG_ELEV@;
    color: @TEXT_PRIMARY@;
    border: 1px solid @BORDER@;
    border-radius: 2px;
    padding: 2px 4px;
    font-size: 12px;
}
QSpinBox:focus, QDoubleSpinBox:focus { border: 1px solid @BORDER_FOCUS@; }

/* ── Tooltips ──────────────────────────────────────────────────── */
QToolTip {
    background: @BG_PANEL_2@;
    color: @TEXT_SECONDARY@;
    border: 1px solid @BORDER@;
    padding: 4px 8px;
    font-size: 11px;
}

/* ── Delta stats strip (chart+orderflow) ───────────────────────── */
QWidget#delta-stats-panel {
    background: @BG_PANEL@;
    border-top: 1px solid @BORDER_FAINT@;
}
QWidget#delta-stats-panel QLabel { color: @TEXT_SECONDARY@; }
